<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C13"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- VOLVER -->
        <Button
            android:id="@+id/btnVolverPokedex"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="← VOLVER A LA POKÉDEX"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#252631"
            android:layout_marginBottom="18dp" />

        <!-- CARTA PRINCIPAL -->
        <LinearLayout
            android:id="@+id/layoutCarta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="18dp"
            android:background="@drawable/bg_pokemon_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POKÉDEX · KANTO"
                android:textColor="#D8DCE6"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ImageView
                android:id="@+id/imgDetalle"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Imagen del Pokémon" />

            <TextView
                android:id="@+id/tvDetalleNumero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="#001"
                android:textSize="15sp"
                android:textColor="#D8DCE6"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvDetalleNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bulbasaur"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_marginTop="5dp" />

            <TextView
                android:id="@+id/tvDetalleTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Planta / Veneno"
                android:textSize="18sp"
                android:textColor="#43E0A0"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <!-- ALTURA Y PESO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="22dp">

                <TextView
                    android:id="@+id/tvAltura"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="ALTURA&#10;0.7 m"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_pokemon_card"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/tvPeso"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="PESO&#10;6.9 kg"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_pokemon_card"
                    android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- EFECTIVIDAD DE TIPOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EFECTIVIDAD DE TIPOS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fortalezas, debilidades y resistencias según sus tipos"
            android:textSize="12sp"
            android:textColor="#9AA2B5"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutEfectividad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_pokemon_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando efectividades..."
                android:textColor="#D8DCE6"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="10dp" />
        </LinearLayout>

        <!-- DATOS DE LA ESPECIE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DATOS DE LA ESPECIE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutDatosEspecie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_pokemon_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando datos de la especie..."
                android:textColor="#D8DCE6"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="10dp" />
        </LinearLayout>

        <!-- ESTADISTICAS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESTADÍSTICAS BASE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="@drawable/bg_pokemon_card" />

        <!-- HABILIDADES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HABILIDADES"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutHabilidades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/bg_pokemon_card" />

        <!-- MOVIMIENTOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOVIMIENTOS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_pokemon_card" />

        <Button
            android:id="@+id/btnVerTodosMovimientos"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="8dp"
            android:text="VER TODOS LOS MOVIMIENTOS"
            android:textColor="#43E0A0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#252631"
            android:visibility="gone" />

        <!-- EVOLUCIONES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CADENA EVOLUTIVA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutEvoluciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp" />
        </HorizontalScrollView>

        <!-- PIE DE PAGINA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POKÉDEX KANTO · GENERACIÓN I"
            android:textSize="11sp"
            android:textColor="#777D8E"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="15dp" />

    </LinearLayout>
</ScrollView>
