<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#11131D">
    <TextView android:id="@+id/txtTituloSelector" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="ELIGE TU POKÉMON"
        android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
        android:gravity="center" android:paddingTop="5dp" android:paddingBottom="14dp"/>
    <EditText android:id="@+id/edtBuscarPokemon" android:layout_width="match_parent"
        android:layout_height="48dp" android:hint="Buscar por nombre o número..."
        android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#858B9D"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:background="@drawable/bg_selector_search" android:inputType="text"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="POKÉMON DE KANTO  ·  001–151" android:textColor="#43E0A0"
        android:textSize="10sp" android:textStyle="bold" android:paddingTop="13dp" android:paddingBottom="8dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerPokemonSelector"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Toca una tarjeta para añadirla a tu equipo" android:textColor="#858B9D"
        android:textSize="11sp" android:gravity="center" android:paddingTop="8dp"/>
</LinearLayout>
